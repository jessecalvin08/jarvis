# ───────────────────────────── J.A.R.V.I.S. configuration
# Copy this file to .env and fill in what you need. Only the model section is required.

# ── Model ─────────────────────────────────────────────────────────────
# anthropic (Claude, recommended) | openai | groq | gemini | openrouter | ollama | custom
LLM_PROVIDER=anthropic

# Claude: get a key at https://console.anthropic.com (API billing is separate from a Claude.ai subscription).
ANTHROPIC_API_KEY=

# Leave empty for the default (claude-opus-5). Faster/cheaper options: claude-sonnet-5, claude-haiku-4-5
LLM_MODEL=

# How hard Claude thinks before answering: low | medium | high | xhigh | max.
# "low" keeps voice replies quick. Raise it for complicated jobs.
LLM_EFFORT=low

# Claude's built-in web search (billed per search). Set to false to disable.
JARVIS_WEB_SEARCH=true

# ── Other providers (only if LLM_PROVIDER is not anthropic) ──────────
# LLM_MODEL must be set for these. Examples - check each provider for current model names:
#   openai      OPENAI_API_KEY=...       LLM_MODEL=gpt-5-mini
#   groq        GROQ_API_KEY=...         LLM_MODEL=openai/gpt-oss-120b   (free tier, very fast)
#   gemini      GEMINI_API_KEY=...       LLM_MODEL=gemini-2.5-flash
#   openrouter  OPENROUTER_API_KEY=...   LLM_MODEL=anthropic/claude-sonnet-5
#   ollama      (no key)                 LLM_MODEL=qwen3:8b   (must support tool calling)
#   custom      LLM_BASE_URL=http://localhost:1234/v1  LLM_API_KEY=...  (LM Studio, vLLM, etc.)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=

# ── Personality ───────────────────────────────────────────────────────
JARVIS_NAME=JARVIS
JARVIS_USER_NAME=
# What Jarvis calls you: sir, boss, ma'am, or your name
JARVIS_USER_TITLE=sir
JARVIS_WAKE_WORD=jarvis
# Speech recognition language, e.g. en-US, en-GB, en-IN
JARVIS_SPEECH_LANG=en-US
# Your city for the weather widget, e.g. "Chennai, India"
JARVIS_LOCATION=

# ── Gmail (optional) ──────────────────────────────────────────────────
# 1. Turn on 2-Step Verification for your Google account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Paste it here (spaces are fine).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ── Voice (optional) ──────────────────────────────────────────────────
# Without a key, Jarvis uses your browser's voices (Edge's "Microsoft Ryan" British voice is very good).
# With ElevenLabs you get film-quality speech: https://elevenlabs.io → Profile → API key.
ELEVENLABS_API_KEY=
# Any voice ID from your ElevenLabs voice library. Default: "George" (British male).
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Offline voice (optional) ──────────────────────────────────────────
# Speech recognition: "browser" (Chrome/Edge send your audio to Google/Microsoft)
# or "local" (Whisper runs on this PC; audio never leaves it).
STT_PROVIDER=browser
# Whisper model for STT_PROVIDER=local. Bigger is more accurate but slower:
#   Xenova/whisper-tiny.en · Xenova/whisper-base.en · Xenova/whisper-small.en
LOCAL_STT_MODEL=Xenova/whisper-base.en
# Already running whisper.cpp's server (e.g. from Jarvis v1)? Point at it and it is used instead:
#   whisper-server -m ggml-base.en.bin --port 8080   →   WHISPER_CPP_URL=http://127.0.0.1:8080
WHISPER_CPP_URL=
# Voice: browser | elevenlabs | kokoro (Kokoro runs offline on this PC).
# Leave empty to use ElevenLabs when a key is set, otherwise the browser voice.
TTS_PROVIDER=
# Kokoro voices: bm_george, bm_fable, bm_lewis, bm_daniel (British male), bf_emma (British female)
KOKORO_VOICE=bm_george
KOKORO_SPEED=1.05

# ── Safety & server ──────────────────────────────────────────────────
# Ask before running shell commands, writing files, sending email, power actions and write-capable MCP tools.
JARVIS_CONFIRM_ACTIONS=true
JARVIS_PORT=7777
JARVIS_OPEN_BROWSER=true
